generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Empleado {
  id                  Int            @id @default(autoincrement())
  email               String         @unique
  nombre              String
  apellido            String
  legajo              String         @unique
  cuil                String?        @unique
  pass                String
  activo              Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?
  roles               Rol[]
  pedidosGenerados    Pedido[]       @relation("PedidoVendedor")
  enviosTomados       Envio[]
  tokens              PassReset[]
  estadoPedidos       EstadoPedido[] @relation("EstadoAuditor")
  pedidoEnPreparacion Pedido?        @relation("PedidoOperario")
}

model Rol {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique
  descripcion String?
  empleados   Empleado[]
  permisos    Permiso[]  @relation("RolPermisos")
}

model Cliente {
  id           Int          @id @default(autoincrement())
  nombre       String
  apellido     String
  email        String       @unique
  telefono     String
  cuit         String
  condicionIva CondicionIva @default(CONSUMIDOR_FINAL)
  activo       Boolean      @default(false)
  comercios    Comercio[]
  pedidos      Pedido[]
}

model Comercio {
  id             Int      @id @default(autoincrement())
  nombre         String // lo que hoy es Cliente.comercio
  telefono       String? // si el del local difiere del dueño
  direccion      String
  latitud        Float
  longitud       Float
  horaAbreMat    String
  horaCierreMat  String
  horaAbreVesp   String
  horaCierreVesp String
  activo         Boolean  @default(true)
  // BATCH 1 ADDITION: tiempo de descarga + firma por parada (minutos).
  tiempoServicioMin Int   @default(10)
  clienteId      Int
  cliente        Cliente  @relation(fields: [clienteId], references: [id])
  pedidos        Pedido[]

  @@index([clienteId])
}

enum Especie {
  PERRO
  GATO
}

model Articulo {
  id                    Int             @id @default(autoincrement())
  codigo                String          @unique
  nombre                String
  descripcion           String?
  presentacion          String // texto para mostrar: "Bolsa 15 kg", "Caja 12 pouch x 85 g"
  especie               Especie?
  precio                Float // neto, sin IVA, por unidad de venta
  precioSugeridoPublico Float? // con IVA, informativo
  pesoGramos            Int? // de la unidad de venta completa
  volumenCm3            Int? // de la unidad de venta completa
  unidadesPorBulto      Int             @default(1)
  stock                 Int             @default(0)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  deletedAt             DateTime?
  marcaId               Int?
  marca                 Marca?          @relation(fields: [marcaId], references: [id])
  alicuotaIvaId         Int?
  alicuotaIva           AlicuotaIva?    @relation(fields: [alicuotaIvaId], references: [id])
  detalles              DetallePedido[]
}

model Marca {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  articulos Articulo[]
}

model Pedido {
  id               Int             @id @default(autoincrement())
  importe          Float
  pesoGramos       Int             @default(0)
  entregaEstimada  DateTime?
  createdAt        DateTime        @default(now())
  clienteId        Int
  cliente          Cliente         @relation(fields: [clienteId], references: [id])
  empleadoId       Int
  empleado         Empleado        @relation("PedidoVendedor", fields: [empleadoId], references: [id])
  envioId          Int?
  envio            Envio?          @relation(fields: [envioId], references: [id])
  articulos        DetallePedido[]
  historialEstados EstadoPedido[]
  stockDescontado  Boolean         @default(false)
  comercioId       Int
  comercio         Comercio        @relation(fields: [comercioId], references: [id])
  operarioId       Int?            @unique
  operario         Empleado?       @relation("PedidoOperario", fields: [operarioId], references: [id])
  // BATCH 1 ADDITION: posición del pedido dentro de la ruta optimizada de su Envio.
  ordenRuta        Int? // 1-based; NULL hasta que se ejecuta el optimizador
  llegadaEstimada  DateTime? // ETA en esta parada, calculada por OR-Tools

  // BATCH 1 ADDITION: evita duplicar ordenRuta dentro del mismo Envio.
  // Postgres trata NULLs como distintos, así que los pedidos sin ruta no chocan.
  @@unique([envioId, ordenRuta])
}

model DetallePedido {
  pedidoId              Int
  articuloId            Int
  cantidad              Int
  precioVenta           Float // neto unitario, congelado al vender
  alicuotaIvaPorcentaje Float    @default(0) // IVA congelado al vender
  descuentoPorcentaje   Float    @default(0)
  pesoUnitarioGramos    Int?
  pedido                Pedido   @relation(fields: [pedidoId], references: [id])
  articulo              Articulo @relation(fields: [articuloId], references: [id])
  verificado            Boolean  @default(false) // escaneado y confirmado por el depósito
  cantidadOriginal      Int? // lo que pidió el vendedor, solo si el depósito lo bajó
  justificacionAjuste   String?

  @@id([pedidoId, articuloId])
}

model Envio {
  id           Int        @id @default(autoincrement())
  fechaEntrega DateTime
  hojaRuta     String?
  createdAt    DateTime   @default(now())
  camionId     Int
  camion       Camion     @relation(fields: [camionId], references: [id])
  pedidos      Pedido[]
  empleados    Empleado[]
  // BATCH 1 ADDITION: cache del resultado del optimizador.
  planRutaId      Int?
  planRuta        PlanRuta?  @relation(fields: [planRutaId], references: [id])
  rutaOptima      Json? // GeoJSON FeatureCollection: un Feature LineString por segmento + markers
  distanciaMetros Float? // total del recorrido de este camión
  duracionSegundos Int? // duración total del recorrido
  optimizadoAt    DateTime? // última vez que se ejecutó el optimizador
}

model Estado {
  id          Int            @id @default(autoincrement())
  nombre      String         @unique
  descripcion String?
  pedidos     EstadoPedido[]
}

model Camion {
  id        Int       @id @default(autoincrement())
  interno   Int       @unique
  marca     String
  modelo    String?
  capacidad Float
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  envios    Envio[]
  // BATCH 1 ADDITION: dimensión de capacidad opcional (cm³) para comparar contra Articulo.volumenCm3.
  capacidadVolumen Float?
  // BATCH 1 ADDITION: false = fuera de servicio / en reparación. Excluye al camión del optimizador.
  disponible       Boolean @default(true)
}

model EstadoPedido {
  pedidoId    Int
  estadoId    Int
  fechaCreac  DateTime    @default(now())
  fechaFin    DateTime?
  pedido      Pedido      @relation(fields: [pedidoId], references: [id])
  estado      Estado      @relation(fields: [estadoId], references: [id])
  motivo      MotivoBaja?
  observacion String?
  auditorId   Int?
  auditor     Empleado?   @relation("EstadoAuditor", fields: [auditorId], references: [id])

  @@id([pedidoId, estadoId, fechaCreac])
}

model PassReset {
  id          Int      @id @default(autoincrement())
  empleadoId  Int
  tokenHash   String   @unique
  fechaExpira DateTime
  usado       Boolean  @default(false)
  fechaCreac  DateTime @default(now())
  empleado    Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
}

enum CondicionIva {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  EXENTO
  CONSUMIDOR_FINAL
}

enum MotivoBaja {
  ARREPENTIMIENTO // cancela, devuelve stock
  PRODUCTO_DANADO // cancela, NO devuelve stock
  CLIENTE_AUSENTE // no cancela: se reprograma
  CLIENTE_RECHAZO // cancela, devuelve stock
}

model AlicuotaIva {
  id          Int        @id @default(autoincrement())
  porcentaje  Float      @unique
  codigoAfip  Int        @unique
  descripcion String?
  articulos   Articulo[]
}

model Permiso {
  id          Int     @id @default(autoincrement())
  codigo      String  @unique // ej: "cliente:create"
  descripcion String?
  roles       Rol[]   @relation("RolPermisos")
}

// ============================================================
// BATCH 1 ADDITION: modelos para el módulo de ruteo
// ============================================================

/// Depósito / playa de carga. Punto de partida y llegada del optimizador.
/// Soporta múltiples depósitos: el usuario elige cuál usar en cada PlanRuta.
model Deposito {
  id           Int       @id @default(autoincrement())
  nombre       String    @unique
  direccion    String
  latitud      Float
  longitud     Float
  horaApertura String    // "08:00" - inicio de la ventana operativa por defecto
  horaCierre   String    // "18:00" - fin de la ventana operativa por defecto
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  planRutas    PlanRuta[]

  @@index([activo])
}

/// Unidad de planificación diaria. Agrupa los Pedidos a rutear y los Camion
/// disponibles para que el optimizador reparta el trabajo entre vehículos.
/// El endpoint POST /plan-rutas/:id/optimize crea un Envio por cada camión
/// asignado y persiste rutaOptima + ordenRuta + llegadaEstimada.
model PlanRuta {
  id         Int       @id @default(autoincrement())
  fecha      DateTime  // el día que se está ruteando (00:00 UTC del día)
  depositoId Int
  deposito   Deposito  @relation(fields: [depositoId], references: [id])
  horaLimite DateTime  // deadline: todos los camiones deben volver antes
  estado     String    @default("PENDIENTE") // PENDIENTE | OPTIMIZADO | EN_PROCESO | FINALIZADO | FALLIDO
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  envios     Envio[]

  @@index([depositoId])
  @@index([fecha])
}
