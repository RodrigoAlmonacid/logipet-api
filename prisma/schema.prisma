// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Modelo de Roles (Vendedor, RRHH, Administración, Depósito, Reparto)
model Rol {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  users       User[]   // Relación 1 a N con Usuarios
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Modelo de Usuarios (Empleados)
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique // El sistema no permitirá crear dos usuarios con el mismo email
  password  String   // Contraseña hasheada
  firstName String
  lastName  String
  phone     String?
  address   String?
  isActive  Boolean  @default(true) // Para bajas lógicas sin borrar el registro
  
  // Claves foráneas y relaciones
  roleId    Int
  role      Rol      @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}