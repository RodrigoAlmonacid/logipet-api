generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empleado {
  id               Int         @id @default(autoincrement())
  email            String      @unique
  nombre           String
  apellido         String
  legajo           String      @unique
  pass             String
  activo           Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?
  roles            Rol[]
  pedidosGenerados Pedido[]
  enviosTomados    Envio[]
  tokens           PassReset[]
}

model Rol {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique
  descripcion String?
  empleados   Empleado[]
}

model Cliente {
  id             Int       @id @default(autoincrement())
  nombre         String
  apellido       String
  comercio       String
  telefono       String
  email          String    @unique
  direccion      String
  latitud        Float
  longitud       Float
  horaAbreMat    String
  horaAbreVesp   String?
  horaCierreMat  String?
  horaCierreVesp String
  activo         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  pedidos        Pedido[]
}

model Articulo {
  id           Int             @id @default(autoincrement())
  codigo       String          @unique
  precio       Float
  presentacion String
  descripcion  String?
  nombre       String
  stock        Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  marcaId      Int?
  marca        Marca?          @relation(fields: [marcaId], references: [id])
  detalles     DetallePedido[]
}

model Marca {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  articulos Articulo[]
}

model Pedido {
  id               Int             @id @default(autoincrement())
  importe          Float
  entregaEstimada  DateTime?
  createdAt        DateTime        @default(now())
  clienteId        Int
  cliente          Cliente         @relation(fields: [clienteId], references: [id])
  empleadoId       Int
  empleado         Empleado        @relation(fields: [empleadoId], references: [id])
  envioId          Int?
  envio            Envio?          @relation(fields: [envioId], references: [id])
  articulos        DetallePedido[]
  historialEstados EstadoPedido[]
}

model DetallePedido {
  pedidoId    Int
  articuloId  Int
  cantidad    Int
  precioVenta Float
  pedido      Pedido   @relation(fields: [pedidoId], references: [id])
  articulo    Articulo @relation(fields: [articuloId], references: [id])

  @@id([pedidoId, articuloId])
}

model Envio {
  id           Int        @id @default(autoincrement())
  fechaEntrega DateTime
  hojaRuta     String?
  createdAt    DateTime   @default(now())
  camionId     Int
  camion       Camion     @relation(fields: [camionId], references: [id])
  pedidos      Pedido[]
  empleados    Empleado[]
}

model Estado {
  id          Int            @id @default(autoincrement())
  nombre      String         @unique
  descripcion String?
  pedidos     EstadoPedido[]
}

model Camion {
  id        Int       @id @default(autoincrement())
  interno   Int       @unique
  marca     String
  modelo    String?
  capacidad Float
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  envios    Envio[]
}

model EstadoPedido {
  pedidoId   Int
  estadoId   Int
  fechaCreac DateTime  @default(now())
  fechaFin   DateTime?
  pedido     Pedido    @relation(fields: [pedidoId], references: [id])
  estado     Estado    @relation(fields: [estadoId], references: [id])

  @@id([pedidoId, estadoId, fechaCreac])
}

model PassReset {
  id          Int      @id @default(autoincrement())
  empleadoId  Int
  tokenHash   String   @unique
  fechaExpira DateTime
  usado       Boolean  @default(false)
  fechaCreac  DateTime @default(now())
  empleado    Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
}
